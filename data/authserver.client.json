{
  "source": "l2jserver/src/main/java",
  "types": {
    "c": {
      "size": 1,
      "description": "целое, 1 байт"
    },
    "h": {
      "size": 2,
      "description": "целое, 2 байта, little-endian"
    },
    "d": {
      "size": 4,
      "description": "целое, 4 байта, little-endian"
    },
    "q": {
      "size": 8,
      "description": "целое, 8 байт, little-endian"
    },
    "f": {
      "size": 8,
      "description": "double, 8 байт, little-endian"
    },
    "s": {
      "size": null,
      "description": "строка UTF-16LE, завершается нулевым символом (2 байта)"
    },
    "b": {
      "size": null,
      "description": "массив байт, длина в поле length (если известна)"
    }
  },
  "legend": {
    "kind": {
      "field": "одно значение типа type; name — путь от DTO или элемента цикла (null — константа/заглушка), value — константа, expr — выражение из serder'а, length — длина для b, javaType — тип в DTO",
      "loop": "повторяющийся блок fields; count — поле/выражение с количеством повторов (если count нет — количество в этом месте пакета не передаётся), condition — условие продолжения",
      "if": "блок fields присутствует при выполнении condition, иначе — блок else (если есть)",
      "switch": "один из блоков cases по значению on"
    },
    "format": "компактная запись раскладки без опкода: [..] — цикл, (a|b) — варианты по условию",
    "opcode": "байты опкода через ':'; в fields опкод не входит"
  },
